# Twitch app credentials (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=

# REQUIRED for automatic token renewal (with TWITCH_REFRESH_TOKEN)
TWITCH_CLIENT_SECRET=

# ---- OPTION A (recommended): auto-renewing tokens ----
# Get an ACCESS + REFRESH token pair via the OAuth Authorization Code flow
# for YOUR client ID (twitchtokengenerator.com "custom client ID" also works).
# Include chat:read + chat:edit scopes if you send chat messages.
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=

# Rotated tokens are persisted here so restarts never hit an expired or stale
# refresh token. Relative to the project root. Keep out of git (data/ is ignored).
TOKEN_STORE_FILE=data/tokens.json

# ---- OPTION B (simple, NO renewal): static token ----
# If you set TWITCH_ACCESS_TOKEN WITHOUT TWITCH_REFRESH_TOKEN/TWITCH_CLIENT_SECRET,
# the bot runs fine but the token will NOT renew itself and stops working on expiry.

# Bot's Twitch username (required only if notifyByChat is used)
TWITCH_BOT_USERNAME=

# Path to the channels config file (relative to project root)
CHANNELS_CONFIG=config.json

# Optional: SQLite database file location
DB_FILE=data/watcher.db