# Twitch app credentials (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# User access token (no scopes needed for metadata events over WebSocket)
# Generate via https://twitchtokengenerator.com or the Twitch CLI
TWITCH_ACCESS_TOKEN=

# Optional: refresh token + client secret enable automatic token refresh.
# NOTE: Twitch refresh tokens are SINGLE-USE and the refreshed token is not
# persisted across restarts, so for dev it's simpler to just paste a fresh
# TWITCH_ACCESS_TOKEN here and leave this empty.
# chat:send scope needed for chat messages.
TWITCH_REFRESH_TOKEN=

# Bot's Twitch username (required only if notifyByChat is used)
TWITCH_BOT_USERNAME=

# Path to the channels config file (relative to project root)
CHANNELS_CONFIG=config.json

# Optional: SQLite database file location
DB_FILE=data/watcher.db